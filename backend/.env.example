# Touch of Hope CBO — Backend Environment Template
# Copy this to .env and fill in your actual values
# NEVER commit .env to Git — only this .env.example file

# ═════════════════════════════════════════════════════════════════
# SERVER CONFIGURATION
# ═════════════════════════════════════════════════════════════════
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5500

# ═════════════════════════════════════════════════════════════════
# DATABASE — MongoDB
# ═════════════════════════════════════════════════════════════════
# Local development:
MONGODB_URI=mongodb://localhost:27017/touch_of_hope

# Production (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/touch_of_hope?retryWrites=true&w=majority

# ═════════════════════════════════════════════════════════════════
# AUTHENTICATION — JWT
# ═════════════════════════════════════════════════════════════════
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_key_at_least_64_characters_long
JWT_EXPIRES_IN=8h

# ═════════════════════════════════════════════════════════════════
# EMAIL — Nodemailer Configuration
# ═════════════════════════════════════════════════════════════════
# Gmail Setup:
# 1. Enable 2-Step Verification on Google Account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Select "Mail" and generate password
# 4. Copy the 16-character password below

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@touchofhope.org
SMTP_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM="Touch of Hope CBO <noreply@touchofhope.org>"

# ═════════════════════════════════════════════════════════════════
# PAYMENT GATEWAY — Stripe
# ═════════════════════════════════════════════════════════════════
# Get from: https://dashboard.stripe.com/apikeys
# Development: Use test keys (sk_test_*, pk_test_*)
# Production: Switch to live keys (sk_live_*, pk_live_*)

STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ═════════════════════════════════════════════════════════════════
# PAYMENT GATEWAY — M-Pesa (Safaricom Daraja)
# ═════════════════════════════════════════════════════════════════
# Get from: https://developer.safaricom.co.ke
# Development: Use sandbox credentials
# Production: Apply for production access (requires business documents)

MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_ENV=sandbox
# MPESA_ENV=production (for live)

# ═════════════════════════════════════════════════════════════════
# PAYMENT GATEWAY — PayPal
# ═════════════════════════════════════════════════════════════════
# Get from: https://developer.paypal.com/dashboard
# Development: Use sandbox credentials
# Production: Switch to live credentials

PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENV=sandbox
# PAYPAL_ENV=production (for live)

# ═════════════════════════════════════════════════════════════════
# API CONFIGURATION
# ═════════════════════════════════════════════════════════════════
# Used by M-Pesa and PayPal for callbacks and redirects
# Development: Use ngrok for M-Pesa (https://abc123.ngrok-free.app)
# Production: Use your live domain (https://api.touchofhope.org)

API_BASE_URL=https://abc123.ngrok-free.app

# ═════════════════════════════════════════════════════════════════
# BACKUP SYSTEM
# ═════════════════════════════════════════════════════════════════
BACKUP_LOCAL_DIR=./backups
RETENTION_DAYS=30

# Cloud storage provider: gcs (Google Cloud), s3 (AWS), azure (Microsoft)
CLOUD_PROVIDER=gcs
CLOUD_BUCKET=toh-backups-2025

# ═════════════════════════════════════════════════════════════════
# REDIS (Optional, for rate limiting and sessions)
# ═════════════════════════════════════════════════════════════════
# Install Redis: https://redis.io/download
# Development: redis://localhost:6379
# Production: Use managed Redis service (AWS ElastiCache, etc)

REDIS_URL=redis://localhost:6379

# ═════════════════════════════════════════════════════════════════
# LOGGING
# ═════════════════════════════════════════════════════════════════
LOG_LEVEL=info
# DEBUG (most verbose), INFO, WARN, ERROR
