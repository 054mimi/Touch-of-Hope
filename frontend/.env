# ================================================================
#  Touch of Hope CBO — Environment Variables
#  Copy to .env and fill in your real values
#  NEVER commit .env to version control
# ================================================================

# ── Server ───────────────────────────────────────────────────────
PORT=8001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── MongoDB ──────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/touch_of_hope
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/touch_of_hope

MONGODB_URI=mongodb+srv://kibendi054_db_user:touchofhope001@version1.bo0gmob.mongodb.net/touch_of_hope?retryWrites=true&w=majority
# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_very_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=8h

# ── Email (Nodemailer) ───────────────────────────────────────────
# For Gmail: enable 2FA → App Passwords → generate one
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@touchofhope.org
SMTP_PASS=your_app_password_here
EMAIL_FROM="Touch of Hope CBO <noreply@touchofhope.org>"

# ── Stripe (handles cards, Apple Pay, Google Pay, bank redirect) ──
# Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# ── M-Pesa (Safaricom Daraja) ────────────────────────────────────
# Register at https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Switch to production when ready:
MPESA_ENV=sandbox
# Callback must be a publicly reachable URL (use ngrok for local dev)
API_BASE_URL=https://api.touchofhope.org

# ── PayPal ───────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENV=sandbox

# ── Backup ───────────────────────────────────────────────────────
BACKUP_LOCAL_DIR=./backups
RETENTION_DAYS=30
CLOUD_PROVIDER=gcs
CLOUD_BUCKET=toh-backups-2025
